# Skopíruj tento súbor ako .env a vyplň hodnoty. Súbor .env NIKDY nedávaj na GitHub.

# Verejná adresa stránky (bez lomky na konci). Používa sa v odkazoch v e-mailoch.
BASE_URL=http://localhost:3000
PORT=3000

# Názov stránky (nepoužívaj v ňom ochrannú známku, napr. "Monster", ani v doméne).
SITE_NAME=Akčná plechovka

# Prevádzkovateľ – povinné podľa GDPR (čl. 13). Stačí meno a kontaktný e-mail.
OPERATOR_NAME=Meno Priezvisko
OPERATOR_ADDRESS=
CONTACT_EMAIL=kontakt@example.com

# Prihlásenie do /admin. Heslo musí mať aspoň 12 znakov, inak je admin vypnutý.
ADMIN_USER=admin
ADMIN_PASSWORD=

# SMTP na odosielanie e-mailov (napr. Brevo, Mailjet, Seznam, Websupport...).
# Ak SMTP_HOST nevyplníš, e-maily sa len vypíšu do konzoly (na testovanie).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Akčná plechovka <upozornenia@example.com>"

# Nastav na 1, ak beží aplikácia za reverse proxy (Render, Railway, Nginx, Cloudflare...).
TRUST_PROXY=0

# Automatická kontrola letákov (1 = zapnutá, 0 = vypnutá) a ako často (v hodinách, minimum 6).
SCRAPE=1
SCRAPE_INTERVAL_HOURS=12
# Po nájdení novej akcie hneď poslať e-maily odberateľom (0 = len zobraziť na stránke).
AUTO_NOTIFY=1

# Cesta k databáze.
DB_PATH=./data/app.db
